# Copie este arquivo para .env e preencha. NUNCA versione o .env real.

# Senha do banco PostgreSQL (use algo longo e aleatório)
DB_PASSWORD=troque-por-uma-senha-forte

# Consultor administrador inicial (criado no primeiro start)
ADMIN_EMAIL=consultor@suaempresa.com.br
ADMIN_SENHA=troque-no-primeiro-acesso

# Domínio com HTTPS automático (aponte o DNS para o IP do servidor)
DOMINIO=diagnostico.suaescola.com.br
